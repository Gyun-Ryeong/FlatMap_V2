# 이 파일은 키 이름만 담는다. 값은 .env (gitignore 대상)에 채운다.
#   cp .env.example .env

# ---- 데이터베이스 (docker-compose.yml 과 백엔드가 함께 사용) ----
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# 호스트 포트. 비우면 compose 기본값(5433)을 쓴다.
DB_PORT=
# 백엔드가 접속할 JDBC URL (예: jdbc:postgresql://localhost:<DB_PORT>/<DB_NAME>)
DB_URL=

# ---- 테스트 (통합 테스트 전용 DB. 개발 DB 와 달라야 하며 이름이 _test 로 끝나야 한다) ----
TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# ---- 인증/보안 ----
JWT_SECRET=
# 관리용 엔드포인트(데이터 수집·갱신) 호출 시 X-Admin-Api-Key 헤더로 보내는 값. 비우면 관리용 엔드포인트가 전부 거부된다.
ADMIN_API_KEY=
FRONTEND_URL=

# ---- 카카오 ----
KAKAO_REST_API_KEY=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=

# ---- 외부 API 키 ----
TMAP_APP_KEY=
WEATHER_API_KEY=
PUBLIC_DATA_API_KEY=
GYEONGGI_API_KEY=
GYEONGGI_SECURITY_LIGHT_API_KEY=
GYEONGGI_ACCIDENT_ICY_API_KEY=
GYEONGGI_ACCIDENT_NORMAL_API_KEY=
GYEONGGI_UPHILL_LANE_API_KEY=
GYEONGGI_SENIOR_WELFARE_API_KEY=
GYEONGGI_SENIOR_CENTER_API_KEY=
DISASTER_STEEP_SLOPE_API_KEY=
DISASTER_TRAFFIC_DOWNHILL_API_KEY=
DISASTER_STEEP_SLOPE_FINAL_API_KEY=

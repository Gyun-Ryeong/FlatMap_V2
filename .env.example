# 이 파일은 키 이름만 담는다. 값은 .env (gitignore 대상)에 채운다.
#   cp .env.example .env

# ---- 데이터베이스 (docker-compose.yml 과 백엔드가 함께 사용) ----
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# 호스트 포트. 비우면 compose 기본값(5433)을 쓴다.
DB_PORT=
# 백엔드가 접속할 JDBC URL (예: jdbc:postgresql://localhost:<DB_PORT>/<DB_NAME>)
DB_URL=

# ---- 테스트 (통합 테스트 전용 DB. 개발 DB 와 달라야 하며 이름이 _test 로 끝나야 한다) ----
TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# ---- 인증/보안 ----
JWT_SECRET=
# 관리용 엔드포인트(데이터 수집·갱신) 호출 시 X-Admin-Api-Key 헤더로 보내는 값. 비우면 관리용 엔드포인트가 전부 거부된다.
ADMIN_API_KEY=
FRONTEND_URL=

# ---- 카카오 ----
KAKAO_REST_API_KEY=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=

# ---- 외부 API 키 ----
TMAP_APP_KEY=
WEATHER_API_KEY=
PUBLIC_DATA_API_KEY=
GYEONGGI_API_KEY=
GYEONGGI_SECURITY_LIGHT_API_KEY=
GYEONGGI_ACCIDENT_ICY_API_KEY=
GYEONGGI_ACCIDENT_NORMAL_API_KEY=
GYEONGGI_UPHILL_LANE_API_KEY=
GYEONGGI_SENIOR_WELFARE_API_KEY=
GYEONGGI_SENIOR_CENTER_API_KEY=
DISASTER_STEEP_SLOPE_API_KEY=
DISASTER_TRAFFIC_DOWNHILL_API_KEY=
DISASTER_STEEP_SLOPE_FINAL_API_KEY=

# ---- 시설 수집 (01 단계) ----
# 보안등 CSV(CP949)의 절대 경로. 슬래시(/)로 적는다 (예: C:/data/seongnam_security_light.csv). 백슬래시는 이스케이프로 읽힌다.
SEONGNAM_SECURITY_LIGHT_CSV_PATH=

# ---- 보행난이도 DEM (06 단계) ----
# DEM(GeoTIFF) 파일 경로. 비워 두면(주석 처리) backend/ 에서 실행할 때의 기본 경로 dem/Copernicus_DSM_COG_10_N37_00_E127_00_DEM.tif 를 쓴다.
# 값이 빈 문자열이면 기본값이 적용되지 않으니, 쓰지 않을 때는 줄 전체를 주석으로 둔다. 슬래시(/)로 적는다.
# WALK_DEM_PATH=C:/data/Copernicus_DSM_COG_10_N37_00_E127_00_DEM.tif
# 경사 임계값·구간 가중·샘플 간격은 application.properties 의 walk.* (검증되지 않은 설계 파라미터)이며 같은 이름의 환경변수로 덮어쓸 수 있다.

# ---- 배포 (08 단계, docker-compose.prod.yml) — 자세한 설명은 docs/ENVIRONMENT.md, 절차는 docs/DEPLOY.md ----
# 프론트 이미지를 빌드할 때 쓰는 카카오 JavaScript 키. 브라우저 번들에 들어가는 "공개 값"이므로
# 카카오 개발자 콘솔에서 허용 도메인을 사이트 주소로 제한한다. (frontend/.env 의 같은 이름은 로컬 개발 서버용)
VITE_KAKAO_API_KEY=
# 아래는 기본값이 있어 보통 필요 없다. 쓸 때만 주석을 풀고 값을 적는다(빈 값으로 두면 기본값이 적용되지 않는 항목이 있다).
# HTTP 가 아니라 HTTPS 로 접속해야 로그인 쿠키(Secure)가 동작한다. HTTP 로만 접근하는 내부 시험 환경에서만 false.
# COOKIE_SECURE=false
# 공개 HTTP 포트(프론트 컨테이너). 기본 80.
# HTTP_PORT=8088
# 서버 안에서 관리용 호출을 할 때 쓰는 백엔드 포트(127.0.0.1 에만 열린다). 기본 8080.
# BACKEND_HOST_PORT=8080
# DEM(GeoTIFF)·보안등 CSV 를 두는 호스트 디렉터리. 컨테이너의 /data 로 읽기 전용 마운트된다. 기본 ./data
# DATA_DIR=/srv/flatmap-data
# compose 프로젝트 이름과 이미지 이름·태그. 기본 flatmap / flatmap / local
# COMPOSE_PROJECT_NAME=flatmap
# IMAGE_PREFIX=flatmap
# IMAGE_TAG=local

# ---- RAG 연동 지점 (09 단계) ----
# RAG 는 개발 중이며 이 저장소에는 서버·구현체가 없다. 기본 false 이며 쓸 필요가 없다(켜도 "미연결"이고 화면에는 진입점이 나오지 않는다).
# RAG_ENABLED=false

# ---- 점수 모델 (03 단계) ----
# 점수 가중치·반경·구간 경계는 backend/src/main/resources/application.properties 의 score.* 에 있다(검증되지 않은 설계 파라미터).
# 같은 이름의 환경변수(예: SCORE_ROUTE_RADIUS_METERS, SCORE_WEIGHT_POLICE)로 덮어쓸 수 있으며, 여기에는 값을 적지 않는다.
# T Map 타임아웃도 TMAP_CONNECT_TIMEOUT_MS / TMAP_READ_TIMEOUT_MS 로 덮어쓸 수 있다.

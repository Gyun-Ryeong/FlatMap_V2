# 프론트 컨테이너의 nginx 설정 템플릿. 시작할 때 ${BACKEND_URL} 과 ${NGINX_RESOLVER} 만 환경변수로 치환된다.
# 같은 출처(/api)로 백엔드에 넘기므로 브라우저 입장에서 CORS 도, 별도 터널·도메인 설정도 필요 없다.

# 앞단(클라우드 로드밸런서·TLS 종단 프록시)이 보낸 X-Forwarded-Proto 가 있으면 그대로 넘기고 없으면 이 서버가 본 스킴을 쓴다.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # 백엔드 주소를 시작할 때 한 번이 아니라 요청 때마다 다시 해석한다. 이렇게 하지 않으면 백엔드 컨테이너만 다시 만들어져 IP 가 바뀔 때
    # (업데이트 등) 프론트가 옛 IP 로 보내 502 가 난다. NGINX_RESOLVER 는 실행 환경의 DNS 주소(Docker 기본 127.0.0.11).
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend_upstream ${BACKEND_URL};

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # 관리용 경로(데이터 수집·격자 재계산)는 공개 주소로 열지 않는다. 관리 호출은 서버 안에서 백엔드(127.0.0.1)로 직접 한다.
    location ~ ^/api/(data|walk-difficulty)(/|$) {
        return 404;
    }
    # 이 경로들은 조회(GET)만 공개한다. 쓰기(POST 등)는 관리용이라 막는다.
    location ~ ^/api/(safety|steep-slope|density-grid)(/|$) {
        limit_except GET HEAD {
            deny all;
        }
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 60s;
    }

    location /api/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # 후보 경로 4종은 T Map 을 순차 호출하므로 응답이 오래 걸릴 수 있다.
        proxy_read_timeout 60s;
    }

    # 해시가 붙은 정적 파일은 오래 캐시하고, index.html 은 항상 다시 확인한다.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }
    location = /index.html {
        expires -1;
    }

    # SPA: 알 수 없는 경로는 index.html 로
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# 프론트엔드 환경변수 (Vite: VITE_ 접두사만 브라우저에 노출된다)
# 값은 이 파일이 아니라 frontend/.env 에 넣는다(.env 는 커밋 금지).
VITE_KAKAO_API_KEY=
VITE_API_BASE_URL=
# 비워 두면 같은 출처(/api)를 쓴다(운영: nginx 가 /api 를 백엔드로 넘김, 개발: Vite 프록시). 백엔드가 다른 출처일 때만 절대 주소.
VITE_BACKEND_URL=

# (개발 전용) 백엔드를 8080 이 아닌 포트로 띄웠을 때 dev 프록시 대상. 비워 두면 http://localhost:8080
# VITE_DEV_PROXY_TARGET=http://localhost:8080
